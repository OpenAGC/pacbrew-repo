+static int PS5AGC_GetOutputSize(SDL_Renderer *renderer, int *w, int *h)
+{
+    PS5AGC_RenderData *data = (PS5AGC_RenderData *)renderer->driverdata;
+    *w = (int)data->mode.width;
+    *h = (int)data->mode.height;
+    return 0;
+}
