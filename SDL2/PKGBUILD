pkgname=ps5-payload-sdl2
pkgver=2.30.12.r20260801.g09ba4a9
pkgrel=1
pkgdesc='SDL2 with the OpenAGC-accelerated PS5 renderer'
arch=('any')
url='https://github.com/OpenAGC/SDL'
license=('Zlib')
options=(!strip libtool staticlibs)

_commit=09ba4a9c544912cf9b5d17163def37593121cdc4
_base_commit=0baf4ac49382b537ba449901b5b6d0d189bb1fbb
source=("SDL-${_base_commit}.tar.gz::${url}/archive/${_base_commit}.tar.gz"
	'openagc-zink-integration.patch')
sha256sums=('cdcf926356a494d43369da2ba204fe7b4d746bc99b324a88656f0beac1cd8e57'
	'e614545585d3eebd3afe841ac4fa2a55e6c0470581d1da686e46aa13285f0c48')

groups=('ps5-payload-dev' 'ps5-payload-sdl2')
depends=('ps5-payload-libsamplerate' 'ps5-payload-openagc'
	'ps5-payload-vulkan-ps5' 'ps5-payload-mesa-zink')
makedepends=('ps5-payload-sdk' 'ps5-payload-libcxx')

prepare() {
    if [ -z "${PS5_PAYLOAD_SDK}" ]; then
	export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
    fi

    cd "SDL-${_base_commit}"
    patch -Np1 -i "${srcdir}/openagc-zink-integration.patch"
}

build() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd "SDL-${_base_commit}"

    ${CMAKE} -S . -B build \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_INSTALL_PREFIX="${PREFIX}" \
	-DOpenAGC_DIR="${PS5_SYSROOT}${PREFIX}/lib/cmake/OpenAGC" \
	-DSDL_PS5_OPENAGC=ON \
	-DSDL_PS5_ZINK=ON \
	-DSDL_OPENGL=YES \
	-DSDL_LOADSO=YES
    ${MAKE} -C build
}

package() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd "SDL-${_base_commit}"

    export DESTDIR="${pkgdir}/${DESTDIR}"
    ${MAKE} -C build install

    ${PS5_CROSS_FIX_ROOT} "${DESTDIR}/${PREFIX}"

    mkdir -p "${pkgdir}/${PS5_PAYLOAD_SDK}/bin"
    ln -s "../target/${PREFIX}/bin/sdl2-config" \
	"${pkgdir}/${PS5_PAYLOAD_SDK}/bin/prospero-sdl2-config"
}
