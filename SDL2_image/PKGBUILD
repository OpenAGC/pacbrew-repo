pkgname=ps5-payload-sdl2_image
pkgver=2.9.0.r20260801.gc8c05a7
pkgrel=1
pkgdesc='SDL2 image loading library.'
arch=('any')
url='https://github.com/libsdl-org/SDL_image'
license=('zlib')
options=(!strip libtool staticlibs)
_commit=c8c05a7647f07b9f6b4dac601905cb6c43fb38b8
source=("SDL_image-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=('ef20db9a618919851d29c8729e19eec899502e35410ebc1c0ea9ace10dbb7d71')
groups=('ps5-payload-dev')
makedepends=('ps5-payload-sdk' 'ps5-payload-openlibm')
depends=('ps5-payload-sdl2'
	 'ps5-payload-libpng'
	 'ps5-payload-libjpeg-turbo'
	 'ps5-payload-libwebp')

prepare() {
    if [ -z "${PS5_PAYLOAD_SDK}" ]; then
	export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
    fi
}

build() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    export SDL2_CONFIG="${PS5_PAYLOAD_SDK}/bin/prospero-sdl2-config"
    cd "SDL_image-${_commit}"

    ./configure --prefix="${PREFIX}" --host=x86_64-pc-freebsd \
		--enable-static --disable-shared
    ${MAKE}
}

package() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd "SDL_image-${_commit}"

    export DESTDIR="${pkgdir}/${DESTDIR}"
    ${MAKE} install

    ${PS5_CROSS_FIX_ROOT} "${DESTDIR}/${PREFIX}"
}
