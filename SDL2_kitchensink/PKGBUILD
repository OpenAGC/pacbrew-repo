pkgname=ps5-payload-sdl2_kitchensink
pkgver=2.0.0.r20260801.gb01841c
pkgrel=1
pkgdesc="FFmpeg and SDL2 based library for audio and video playback, written in C99."
arch=('any')
url="https://katajakasa.github.io/SDL_kitchensink/"
license=('MIT')
_commit=b01841c7805da91376ac7ded2f737c6347bb98a2
source=("SDL_kitchensink-${_commit}.tar.gz::https://github.com/katajakasa/SDL_kitchensink/archive/${_commit}.tar.gz")
sha256sums=('90bdb0a293e70dc0c6e75e182bcf3719c8b3a3fe058ce667ff8c58ef2346f74a')

options=(!strip libtool staticlibs)
groups=('ps5-payload-dev')
makedepends=('ps5-payload-sdk')
depends=('ps5-payload-sdl2' 'ps5-payload-ffmpeg' 'ps5-payload-libass')

prepare() {
    if [ -z "${PS5_PAYLOAD_SDK}" ]; then
	export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
    fi

    cd "SDL_kitchensink-${_commit}"
    sed -i 's|double pts = Kit_GetCurrentPTS(decoder);|double pts = Kit_GetCurrentPTS(decoder)+0.1;|g' src/internal/video/kitvideo.c
}

build() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd "SDL_kitchensink-${_commit}"

    ${CMAKE} -DCMAKE_BUILD_TYPE=Release \
	     -DSDL2_DIR="${PS5_SYSROOT}${PREFIX}/lib/cmake/SDL2" \
	     -DBUILD_STATIC=YES \
	     -DBUILD_SHARED=NO \
	     -B build \
             -S .
    ${MAKE} -C build
}

package() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd "SDL_kitchensink-${_commit}"

    export DESTDIR="${pkgdir}/${DESTDIR}"
    ${MAKE} -C build install

    cd $DESTDIR/$PREFIX/lib
    ln -s libSDL_kitchensink_static.a libSDL_kitchensink.a
}
