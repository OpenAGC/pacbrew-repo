+        "extended image view destroys");
+    TEST_ASSERT_EQ(agcDestroyImage(image), AGC_OK,
+        "extended-view source image destroys");
+    TEST_ASSERT_EQ(agcDestroyDevice(device), AGC_OK,
+        "extended resource device destroys");
+}
