+                print(f"expected: {wanted}", file=sys.stderr)
+                print(f"actual:   {actual}", file=sys.stderr)
+                break
+        return 1
+    print("vulkan-capability-baseline: PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
