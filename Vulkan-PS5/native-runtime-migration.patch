+        "http://${PS5_HOST}:8080/hbldr?pipe=0&daemon=1&path=${cleanup_dir}/eboot.elf" \
+        >/dev/null
+    sleep 2
+    if ! curl -sS --connect-timeout 3 --max-time 5 \
+        "http://${PS5_HOST}:8080/" >/dev/null; then
