+    if (vkCreateImage(device, pInfo->pCreateInfo, NULL, &image) != VK_SUCCESS)
+        return;
+    vkGetImageSubresourceLayout2(
+        device, image, pInfo->pSubresource, pLayout);
+    vkDestroyImage(device, image, NULL);
+}
