pkgname=ps5-payload-mesa-zink
pkgver=26.3.0_devel.r20260801.gba27d45
pkgrel=1
pkgdesc='Pinned Mesa EGL and Zink runtime for Vulkan-PS5'
arch=('any')
url='https://gitlab.freedesktop.org/mesa/mesa'
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
options=(!strip libtool)

_commit=ba27d457971d7621f239b0e0a76b98f59ce533b0
_base_commit=44e18d3d7783c751fd77aeba01bbff28db97945a
_mesa_libver=26.3.0-devel
source=("mesa-${_base_commit}.tar.gz::https://gitlab.freedesktop.org/mesa/mesa/-/archive/${_base_commit}/mesa-${_base_commit}.tar.gz"
	'prospero-zink.patch'
	'ps5-mesa-cross.ini')
sha256sums=('256ed333fc8ab64c6778e7c333061163633e873759abb2136c4a7a363b6decc8'
	'51c8547b6d46a7d30f66b448657f8c467d782d20e99eae5d36253a81d784926b'
	'240907b9debbdb61f17941e0ec7d6bc33de67bf02a5ef5ec221a5132dd9f5069')

groups=('ps5-payload-dev' 'ps5-payload-gl')
depends=('ps5-payload-libcxx' 'ps5-payload-vulkan-ps5')
makedepends=('ps5-payload-sdk')

prepare() {
    if [ -z "${PS5_PAYLOAD_SDK}" ]; then
	export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
    fi

    cd "mesa-${_base_commit}"
    patch -Np1 -i "${srcdir}/prospero-zink.patch"
}

build() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd "mesa-${_base_commit}"

    unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS PKG_CONFIG_PATH
    ${MESON} setup builddir \
	--cross-file="${srcdir}/ps5-mesa-cross.ini" \
	-Dgallium-drivers=zink \
	'-Dvulkan-drivers=[]' \
	'-Dplatforms=[]' \
	-Dglx=disabled \
	-Degl=enabled \
	-Dgbm=disabled \
	-Dllvm=disabled \
	-Dshared-glapi=disabled \
	-Dopengl=true \
	-Dgles1=disabled \
	-Dgles2=disabled \
	-Dbuild-tests=false \
	-Dvalgrind=disabled \
	-Dlibunwind=disabled \
	-Dzlib=disabled \
	-Dzstd=disabled \
	-Dshader-cache=disabled \
	'-Dvideo-codecs=[]' \
	'-Dtools=[]'
    ${MESON} compile -vC builddir
}

package() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd "mesa-${_base_commit}"

    ${MESON} install -C builddir --destdir "${srcdir}/runtime-stage"
    install -Dm755 \
	"${srcdir}/runtime-stage${PREFIX}/lib/libEGL.so.1.0.0" \
	"${pkgdir}/${PS5_SYSROOT}${PREFIX}/lib/libEGL.so.1.0.0"
    ln -s libEGL.so.1.0.0 \
	"${pkgdir}/${PS5_SYSROOT}${PREFIX}/lib/libEGL.so.1"
    ln -s libEGL.so.1 \
	"${pkgdir}/${PS5_SYSROOT}${PREFIX}/lib/libEGL.so"
    install -Dm755 \
	"${srcdir}/runtime-stage${PREFIX}/lib/libgallium-${_mesa_libver}.so" \
	"${pkgdir}/${PS5_SYSROOT}${PREFIX}/lib/libgallium-${_mesa_libver}.so"
}
