pkgname=ps5-payload-openal
pkgver=1.24.3
pkgrel=2
pkgdesc='Cross-platform 3D audio library, software implementation'
arch=('any')
url='https://github.com/kcat/openal-soft'
license=('LGPL-2.0-or-later')
options=(!strip libtool staticlibs)
source=("https://github.com/kcat/openal-soft/archive/refs/tags/$pkgver.tar.gz"
	'0001-Find-SDL2-in-installed-CMake-config.patch')
sha256sums=('7e1fecdeb45e7f78722b776c5cf30bd33934b961d7fd2a11e0494e064cc631ce'
	    '7fbb6b4f3b873940b083e83268db22928098d8b7a2923e80ca4d41db592df221')

groups=('ps5-payload-dev')
makedepends=('ps5-payload-sdk')
depends=('ps5-payload-sdl2' 'ps5-payload-libcxx')

prepare() {
    if [ -z "${PS5_PAYLOAD_SDK}" ]; then
	export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
    fi

    cd openal-soft-$pkgver
    patch -Np1 -i ../0001-Find-SDL2-in-installed-CMake-config.patch
}

build() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd openal-soft-$pkgver

    ${CMAKE} -DCMAKE_BUILD_TYPE=Release \
	     -DALSOFT_DLOPEN=NO \
	     -DALSOFT_RTKIT=NO \
	     -DALSOFT_BACKEND_PIPEWIRE=NO \
	     -DALSOFT_BACKEND_PULSEAUDIO=NO \
	     -DALSOFT_BACKEND_ALSA=NO \
	     -DALSOFT_BACKEND_OSS=NO \
	     -DALSOFT_BACKEND_SOLARIS=NO \
	     -DALSOFT_BACKEND_SNDIO=NO \
	     -DALSOFT_BACKEND_JACK=NO \
	     -DALSOFT_BACKEND_COREAUDIO=NO \
	     -DALSOFT_BACKEND_OBOE=NO \
	     -DALSOFT_BACKEND_OPENSL=NO \
	     -DALSOFT_BACKEND_PORTAUDIO=NO \
	     -DALSOFT_BACKEND_SDL3=NO \
	     -DALSOFT_BACKEND_SDL2=YES \
	     -DALSOFT_REQUIRE_SDL2=YES \
	     -DALSOFT_BACKEND_WAVE=NO \
	     -DALSOFT_UTILS=NO \
	     -DALSOFT_NO_CONFIG_UTIL=YES \
	     -DALSOFT_EXAMPLES=NO \
	     -DALSOFT_TESTS=NO \
	     -DALSOFT_INSTALL=YES \
	     -DALSOFT_INSTALL_CONFIG=NO \
	     -DALSOFT_INSTALL_HRTF_DATA=NO \
	     -DALSOFT_INSTALL_AMBDEC_PRESETS=NO \
	     -DALSOFT_INSTALL_EXAMPLES=NO \
	     -DALSOFT_INSTALL_UTILS=NO \
	     -DALSOFT_EMBED_HRTF_DATA=YES \
	     -DLIBTYPE="STATIC" \
	     -B build \
             -S .
    ${MAKE} -C build
}

package() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd openal-soft-$pkgver

    export DESTDIR="${pkgdir}/${DESTDIR}"
    ${MAKE} -C build install

    ${PS5_CROSS_FIX_ROOT} "${DESTDIR}/${PREFIX}"
}
