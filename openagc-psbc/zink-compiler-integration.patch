+static void test_alpha_to_one(const uint32_t *spirv, size_t size)
+{
+    OpenAgcPsbcPipelineContext pipeline = {
+        .color_attachment_count = 1,
+    };
+    const OpenAgcPsbcCompileInfo info = {
+        .api_version = OPENAGC_PSBC_API_VERSION,
+        .stage = OPENAGC_PSBC_STAGE_FRAGMENT,
+        .spirv = spirv,
+        .spirv_size = size,
+        .entry_point = "main",
+        .pipeline = &pipeline,
+        .optimize = true,
+    };
+    OpenAgcPsbcOutput ordinary = {0};
+    OpenAgcPsbcOutput forced = {0};
+    assert(openagcPsbcCompile(&info, &ordinary) == OPENAGC_PSBC_SUCCESS);
+    pipeline.alpha_to_one = true;
+    assert(openagcPsbcCompile(&info, &forced) == OPENAGC_PSBC_SUCCESS);
+    validate_record(&ordinary);
+    validate_record(&forced);
+    assert((ordinary.metadata.flags &
+            AGC_SHADER_REFLECTION_ALPHA_TO_ONE_BIT) == 0u);
+    assert((forced.metadata.flags &
+            AGC_SHADER_REFLECTION_ALPHA_TO_ONE_BIT) != 0u);
+    assert(ordinary.shader.size != forced.shader.size ||
+           memcmp(ordinary.shader.data, forced.shader.data,
+                  ordinary.shader.size) != 0);
+    openagcPsbcFreeOutput(&ordinary);
+    openagcPsbcFreeOutput(&forced);
+}
