pkgname=ps5-payload-openagc-psbc
pkgver=0.1.0.r20260801.ga95a68d
pkgrel=1
pkgdesc='OpenAGC runtime SPIR-V compiler for PS5 payloads'
arch=('any')
url='https://github.com/OpenAGC/openagc-psbc'
license=('MIT')
options=(!strip libtool staticlibs)

_commit=a95a68da0b379df6a7e5f145958b3cedaab1c897
source=("openagc-psbc-${_commit}.tar.gz::https://github.com/OpenAGC/openagc-psbc/archive/${_commit}.tar.gz")
sha256sums=('8740089c307f6e83a32cf3904ca66f1d2eae9a3859d73168d165f9be13b238c4')

groups=('ps5-payload-dev')
depends=('ps5-payload-libcxx')
makedepends=('ps5-payload-sdk' 'ps5-payload-openagc'
	'ps5-payload-vulkan-headers')

prepare() {
    if [ -z "${PS5_PAYLOAD_SDK}" ]; then
	export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
    fi
}

build() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd "openagc-psbc-${_commit}"

    ${MAKE} -f Makefile.prospero \
	OPENAGC_INCLUDE="${PS5_SYSROOT}${PREFIX}/include" \
	VULKAN_INCLUDE="${PS5_SYSROOT}${PREFIX}/include" \
	PROSPERO_LIBCXX_INCLUDE="${PS5_SYSROOT}/include/c++/v1"
}

package() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd "openagc-psbc-${_commit}"

    install -Dm644 libopenagc_psbc.prospero.a \
	"${pkgdir}/${PS5_SYSROOT}${PREFIX}/lib/libopenagc_psbc.a"
    install -Dm644 libopenagc_psbc/openagc_psbc.h \
	"${pkgdir}/${PS5_SYSROOT}${PREFIX}/include/openagc_psbc.h"
}
